# Server-only. Never expose the service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL (target: https://www.presencehospitality.com)
NEXT_PUBLIC_SITE_URL=
# Show TODO(media) placeholders for future Holobox footage
SHOW_MEDIA_PLACEHOLDERS=false
# Supabase (publishable + secret keys). Secret key is server-only.
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
# Lead notifications (Resend)
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_NOTIFY_FROM=
# Daily keep-alive cron (Vercel sends it as a Bearer token)
CRON_SECRET=
